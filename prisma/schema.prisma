generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// GLOBAL TABLES (job ingestion layer — shared across all users)
// ─────────────────────────────────────────────────────────────────────────────

model JobSource {
  id             String    @id @default(cuid())
  company        String
  provider       String
  boardToken     String?
  url            String    @unique
  enabled        Boolean   @default(true)
  priority       Int       @default(0)
  tags           String? // JSON array
  lastSyncAt     DateTime?
  lastSyncStatus String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // ── Workday / advanced lifecycle fields ─────────────────────────────────────
  /// "API" | "SCRAPER" | "AUTO" | "DISABLED"  (null = provider default)
  fetchStrategy      String?
  /// "unverified" | "api_valid" | "wrong_site_slug" | "auth_blocked" |
  /// "browser_required" | "host_dead" | "invalid_schema" |
  /// "temporary_failure" | "scraper_candidate" | "scraper_valid" | "disabled"
  verificationStatus String?
  /// When non-null, source is in backoff and must not be synced before this time
  nextRetryAt        DateTime?
  /// JSON blob — failure counts, last error, high-priority flag, per-provider metadata
  metadata           String?

  jobs        Job[]
  userSources UserJobSource[]

  @@index([provider, verificationStatus])
  @@index([enabled, nextRetryAt])
}

model Job {
  id             String    @id @default(cuid())
  sourceId       String
  externalId     String?
  company        String
  title          String
  location       String?
  department     String?
  employmentType String?
  applyUrl       String
  description    String?
  postedAt       DateTime?
  effectiveNewAt DateTime?

  /// Normalized fingerprint for cross-source deduplication: provider|externalId or company|title|location
  jobFingerprint String?

  sponsorship String @default("UNKNOWN")
  /// Legacy global status — preserved for backward compat; prefer UserJobStatus
  status      String @default("NEW")

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  isActive    Boolean  @default(true)

  /// Set after this job is included in an ALL_NEW_JOBS notification delivery
  allNewJobsNotifiedAt DateTime?

  source              JobSource              @relation(fields: [sourceId], references: [id])
  /// Legacy global recommendations — preserved for backward compat
  recommendations     JobRecommendation[]
  /// Per-user recommendations (new)
  userRecommendations UserJobRecommendation[]
  /// Per-user status (new)
  userStatuses        UserJobStatus[]

  @@unique([sourceId, applyUrl])
  @@index([isActive])
  @@index([status])
  @@index([sponsorship])
  @@index([sourceId])
  @@index([postedAt])
  @@index([firstSeenAt])
  @@index([effectiveNewAt])
  @@index([isActive, postedAt])
  @@index([isActive, effectiveNewAt])
  @@index([jobFingerprint])
  @@index([isActive, firstSeenAt])
  @@index([allNewJobsNotifiedAt])
}

model SyncRun {
  id               String    @id @default(cuid())
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  status           String
  sourcesProcessed Int       @default(0)
  sourcesSucceeded Int       @default(0)
  sourcesFailed    Int       @default(0)
  jobsCreated      Int       @default(0)
  jobsUpdated      Int       @default(0)
  jobsMarkedStale  Int       @default(0)
  errorSummary     String?
  createdAt        DateTime  @default(now())

  sourceRuns SyncSourceRun[]
}

model SyncSourceRun {
  id           String    @id @default(cuid())
  syncRunId    String
  sourceId     String?
  company      String?
  provider     String?
  status       String
  jobsFetched  Int       @default(0)
  jobsCreated  Int       @default(0)
  jobsUpdated  Int       @default(0)
  errorMessage String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  syncRun SyncRun @relation(fields: [syncRunId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// LEGACY GLOBAL RECOMMENDATION TABLES
// Kept for backward compat — new runs write to UserJobRecommendation instead
// ─────────────────────────────────────────────────────────────────────────────

model RoleProfile {
  id       String  @id @default(cuid())
  name     String  @unique
  enabled  Boolean @default(true)
  priority Int     @default(0)

  preferredTitles    String // JSON array
  preferredLocations String // JSON array
  mustHaveKeywords   String // JSON array
  niceHaveKeywords   String // JSON array
  negativeKeywords   String // JSON array

  requiresSponsorship Boolean @default(false)
  minScore            Int     @default(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recommendations JobRecommendation[]
}

model JobRecommendation {
  id            String @id @default(cuid())
  jobId         String
  roleProfileId String

  score     Int
  reason    String?
  matched   String // JSON array
  negatives String // JSON array

  status        String    @default("UNSEEN") // UNSEEN, SEEN, SAVED, APPLIED, SKIPPED
  recommendedAt DateTime  @default(now())

  notifiedAt             DateTime?
  notificationDeliveryId String?

  job         Job         @relation(fields: [jobId], references: [id])
  roleProfile RoleProfile @relation(fields: [roleProfileId], references: [id])

  @@unique([jobId, roleProfileId])
  @@index([recommendedAt])
  @@index([status, recommendedAt])
  @@index([roleProfileId, recommendedAt])
  @@index([status])
  @@index([notifiedAt])
  @@index([jobId, status])
}

model RecommendationRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String // RUNNING, SUCCESS, PARTIAL_FAILURE, FAILED

  windowStart DateTime
  windowEnd   DateTime

  jobsScanned            Int     @default(0)
  recommendationsCreated Int     @default(0)
  errorSummary           String?

  notifications NotificationDelivery[]
}

model NotificationDelivery {
  id                  String    @id @default(cuid())
  channel             String    // TELEGRAM, DISCORD, SLACK, NONE
  status              String    // SENT, FAILED, SKIPPED
  /// RECOMMENDED_JOBS | ALL_NEW_JOBS | TEST | SYNC_HEALTH
  notificationType    String    @default("RECOMMENDED_JOBS")
  windowHours         Int       @default(1)
  recommendationCount Int       @default(0)
  jobCount            Int       @default(0)
  messagePreview      String?
  errorMessage        String?
  sentAt              DateTime?
  createdAt           DateTime  @default(now())

  recommendationRunId String?
  recommendationRun   RecommendationRun? @relation(fields: [recommendationRunId], references: [id])

  @@index([channel, createdAt])
  @@index([status, createdAt])
  @@index([notificationType, createdAt])
  @@index([recommendationRunId])
}

// ─────────────────────────────────────────────────────────────────────────────
// USER LAYER — per-user data, preferences, recommendations, history
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  name         String?
  fullName     String?  // Display name from registration / onboarding
  passwordHash String?  // bcrypt hash; null = no login set yet
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notificationPreferences UserNotificationPreference[]
  roleProfiles            UserRoleProfile[]
  jobStatuses             UserJobStatus[]
  recommendations         UserJobRecommendation[]
  recommendationRuns      UserRecommendationRun[]
  preferences             UserJobPreference?
  onboarding              UserOnboarding?
  jobSources              UserJobSource[]

  @@index([isDefault])
}

model UserOnboarding {
  id                  String    @id @default(cuid())
  userId              String    @unique
  onboardingCompleted Boolean   @default(false)
  onboardingVersion   Int       @default(1)
  prefsJson           String?   // JSON blob of onboarding wizard answers
  completedAt         DateTime? // Set once on first completion — never cleared

  /// Set to true only by explicit admin/backend action (e.g. schema migration).
  /// Must NOT be inferred from sourceCount=0, empty prefs, sync failures, etc.
  requiresReboarding  Boolean   @default(false)
  reboardingReason    String?   // Human-readable reason shown in onboarding wizard

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model UserJobSource {
  id       String @id @default(cuid())
  userId   String
  sourceId String

  enabled  Boolean @default(true)
  priority Int     @default(0)
  tags     String? // JSON array — user-specific tag overrides

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User      @relation(fields: [userId], references: [id])
  source JobSource @relation(fields: [sourceId], references: [id])

  @@unique([userId, sourceId])
  @@index([userId, enabled])
}

model UserRoleProfile {
  id     String @id @default(cuid())
  userId String

  name     String
  enabled  Boolean @default(true)
  priority Int     @default(0)

  preferredTitles    String // JSON array
  preferredLocations String // JSON array
  mustHaveKeywords   String // JSON array
  niceHaveKeywords   String // JSON array
  negativeKeywords   String // JSON array

  requiresSponsorship Boolean @default(false)
  minScore            Int     @default(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User                   @relation(fields: [userId], references: [id])
  recommendations UserJobRecommendation[]

  @@unique([userId, name])
  @@index([userId, enabled])
}

model UserJobPreference {
  id     String @id @default(cuid())
  userId String @unique

  targetLocations    String? // JSON array
  targetRoles        String? // JSON array
  blockedCompanies   String? // JSON array
  preferredCompanies String? // JSON array

  minScore            Int     @default(45)
  requiresSponsorship Boolean @default(false)

  /// When true, sync and recommendations use globally enabled sources
  /// when this user has zero UserJobSource rows.
  /// Default false — global sources are an explicit opt-in, not a silent fallback.
  useGlobalDefaultSources Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model UserJobStatus {
  id     String @id @default(cuid())
  userId String
  jobId  String

  status    String    @default("NEW") // NEW, SAVED, APPLIED, SKIPPED
  notes     String?
  appliedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  job  Job  @relation(fields: [jobId], references: [id])

  @@unique([userId, jobId])
  @@index([userId, status])
  @@index([userId, updatedAt])
}

model UserJobRecommendation {
  id                String @id @default(cuid())
  userId            String
  jobId             String
  userRoleProfileId String

  score     Int
  reason    String?
  matched   String // JSON array
  negatives String // JSON array

  status        String    @default("UNSEEN") // UNSEEN, SEEN, SAVED, APPLIED, SKIPPED
  recommendedAt DateTime  @default(now())

  notifiedAt             DateTime?
  notificationDeliveryId String?

  user            User            @relation(fields: [userId], references: [id])
  job             Job             @relation(fields: [jobId], references: [id])
  userRoleProfile UserRoleProfile @relation(fields: [userRoleProfileId], references: [id])

  @@unique([userId, jobId, userRoleProfileId])
  @@index([userId, status, recommendedAt])
  @@index([userId, notifiedAt])
  @@index([userId, recommendedAt])
}

model UserRecommendationRun {
  id     String @id @default(cuid())
  userId String

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String // RUNNING, SUCCESS, PARTIAL_FAILURE, FAILED

  windowStart DateTime
  windowEnd   DateTime

  jobsScanned            Int     @default(0)
  recommendationsCreated Int     @default(0)
  recommendationsUpdated Int     @default(0)
  errorSummary           String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, startedAt])
  @@index([userId, status])
}

model UserNotificationPreference {
  id      String @id @default(cuid())
  userId  String
  channel String // SLACK, TELEGRAM, DISCORD

  enabled Boolean @default(false)

  slackWebhookUrl   String?
  telegramBotToken  String?
  telegramChatId    String?
  discordWebhookUrl String?

  lookbackHours     Int @default(24)
  maxJobs           Int @default(10)
  maxJobsPerCompany Int @default(2)

  // All-new-jobs digest settings
  allNewJobsEnabled     Boolean @default(true)
  allNewJobsLookbackHours Int   @default(1)
  allNewJobsMaxJobs     Int     @default(50)
  allNewJobsMaxCompanies Int    @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, channel])
  @@index([userId])
}
