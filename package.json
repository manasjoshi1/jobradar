    "node-cron": "4.2.1",
    "p-limit": "7.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "0.18.5",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "^20",
    "@types/node-cron": "3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "6.19.3",
    "start-server-and-test": "3.0.5",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "wait-on": "9.0.10"
  }
