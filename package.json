{
  "name": "jobradar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "config:import": "tsx scripts/config-import.ts",
    "db:backfill-effective-new-at": "node scripts/backfill-effective-new-at.mjs",
    "runs:recover": "node scripts/recover-abandoned-runs.mjs",
    "deploy:bootstrap": "node scripts/deploy-bootstrap.mjs",
    "db:seed-user": "node scripts/seed-default-user.mjs",
    "db:investigate": "node scripts/investigate-duplicates.mjs",
    "users:migrate-default": "node scripts/migrate-default-user.mjs",
    "users:import-config": "node scripts/import-user-config.mjs",
    "seed:companies": "node scripts/seed-companies.mjs",
    "auth:set-password": "node scripts/set-password.mjs",
    "e2e:seed": "node scripts/e2e-seed.mjs",
    "start:e2e": "next start -H 127.0.0.1 -p 3000",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:ci": "playwright test --reporter=line,html",
    "ci:e2e": "start-server-and-test start:e2e http://127.0.0.1:3000 test:e2e:ci"
