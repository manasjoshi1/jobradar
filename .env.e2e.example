# ── E2E test environment ─────────────────────────────────────────────────────
# Copy to .env.e2e and fill in any local overrides.
# GitHub Actions sets these variables directly in the workflow — no .env file needed in CI.
#
# NEVER commit .env.e2e (it's in .gitignore).

DATABASE_URL="file:./prisma/e2e.db"
NODE_ENV=test
E2E_TEST=true

# JWT signing secret — must be ≥ 32 chars
SESSION_SECRET="e2e-session-secret-at-least-32-characters-long"

# Disable the background scheduler in tests
ENABLE_SCHEDULER=false

# Disable all external notifications
NOTIFICATIONS_ENABLED=false
NOTIFICATION_CHANNEL=none
ALL_NEW_JOBS_NOTIFICATIONS_ENABLED=false

# Cookie is not Secure on plain HTTP (handled by COOKIE_SECURE flag)
COOKIE_SECURE=false

# Point at e2e fixture config (not production YAML)
CONFIG_DIR=./config/e2e

# Sync settings — irrelevant in E2E but silence any default warnings
SYNC_FETCH_CONCURRENCY=2
SYNC_DB_CONCURRENCY=1
SOURCE_FETCH_TIMEOUT_MS=3000
SOURCE_FETCH_RETRIES=0

# App URL — used for any internal absolute links
APP_PUBLIC_URL=http://127.0.0.1:3000
